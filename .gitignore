# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — never commit real env files; only commit env.example
.env
.env.*
.env.development
.env.production
.env.staging

# vercel / snyk local auth
.vercel
.snyk
.dccache

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS junk (keep .vscode + .cursor/rules committed)
*.swp
*.swo
.idea/
